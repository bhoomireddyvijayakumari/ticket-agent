[Unit]
Description=LangChain MCP ticket analysis worker
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/ticket-agent
EnvironmentFile=/home/ubuntu/ticket-agent/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/ticket-agent/.venv/bin/ticket-agent watch --apply --interval 300 --limit 5
Restart=on-failure
RestartSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
